{
  "name": "dsh-dock-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 build-demo.py",
    "build:zh": "python3 build-demo.py --lang zh",
    "build:en": "python3 build-demo.py --lang en",
    "dev": "npx --yes hyperframes@0.8.226 preview",
    "check": "npx --yes hyperframes@0.8.226 check",
    "render": "python3 render-film.py",
    "render:zh": "python3 render-film.py --lang zh",
    "render:en": "python3 render-film.py --lang en",
    "build:preview": "python3 build-preview.py --lang zh && python3 build-preview.py --lang en",
    "render:preview": "python3 render-preview.py"
  }
}
