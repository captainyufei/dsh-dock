{
  "name": "@captainyufei/dsh-dock",
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "check:package": "node scripts/build.mjs && node scripts/check-package.mjs",
    "check": "npm test && npm run check:package",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "prepare:release": "npm run check && node scripts/prepare-release.mjs",
    "build:client": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "^18.3.1",
    "semver": "7.8.6"
  },
  "description": "Application Dock, global search, completion inbox, navigation history, draft-first Home and side-panel video previews for DeepSeek Harness.",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./dist/locale/*.json",
    "./icon": "./dist/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "README.en.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "captainyufei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/captainyufei/dsh-dock.git"
  },
  "homepage": "https://github.com/captainyufei/dsh-dock#readme",
  "bugs": {
    "url": "https://github.com/captainyufei/dsh-dock/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dock",
    "sidebar",
    "ui",
    "workspace"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "license": "MIT"
}
